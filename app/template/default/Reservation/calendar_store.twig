{% extends 'default_frame.twig' %}
{% block stylesheet %}
    <style>
        .cannot-book-date{
            background-image: url("/html/template/default/assets/icon/can-not-book.svg");
            background-repeat: no-repeat;
            background-position: top 5px right 5px;
            pointer-events: none;
        }
        .can-book-date{
            background-image: url("/html/template/default/assets/icon/can-book-part.svg");
            background-repeat: no-repeat;
            background-position: top 5px right 5px;
        }
        .empty-date{
            background-image: url("/html/template/default/assets/icon/can-book.svg");
            background-repeat: no-repeat;
            background-position: top 5px right 5px;

        }
    </style>
{% endblock %}

{% block javascript %}
    <script>
        function date_format (date) {
            var mm = date.getMonth() + 1;
            var dd = date.getDate();
            return [date.getFullYear(),
                (mm>9 ? '' : '0') + mm,
                (dd>9 ? '' : '0') + dd
            ].join('-');
        }
        $(function(){
            let listBookedDate = [{%- for d in listBookedDate %}"{{d}}", {% endfor -%}];
            let listCannotBookDate = [{%- for d in listCannotBookDate %}"{{d}}", {% endfor -%}];
            let listHodiday = [{%- for d in listHodiday %}"{{d}}", {% endfor -%}];

		    var dateFormat = "yyyy-mm-dd";
            var options = {
                format: dateFormat,
                language: 'ja',
                autoclose : true,
                keyboardNavigation : false,
                showMonthAfterYear: true,
                monthNames: ["1月","2月","3月","4月","5月","6月","7月","8月","9月","10月","11月","12月"],
                todayHighlight : true,
                startDate: '+' + {{grayoutAfterToDay}} + 'd',
                beforeShowDay: function(date) {
                        var date_after_format = date_format(date);
                        // tuesday grayout, except tuesday of march, july, august and holiday
                        if(
                            (date.getDay() == 2) &&
                            ![2, 6, 7].includes(date.getMonth())
                            &&
                            !listHodiday.includes(date_after_format))
                            {
                            return false;
                        }
                        // if date not in list can not book (can order in this date)
                        if({{ quantityMaxSetting }} == 0 || listCannotBookDate.indexOf(date_after_format) != -1){
                            return {
                                classes: 'cannot-book-date',
                                enabled: true
                            }
                        }
                        else if ({{ quantityMinSetting }} == 0 || listBookedDate.indexOf(date_after_format) != -1){
                            return {
                                classes: 'can-book-date',
                                enabled: true
                            }
                        }
                        return {
                            classes: 'empty-date',
                            enabled: true
                        }
                },
		    };
            $('#plg_wear_date_detail').datepicker(options).on('changeDate', function(e){
                url = '{{url('list_time') }}?shop=' + '{{store_name_en}}' + '&date=' + date_format(e.date);
                if('{{product_code}}'){
                    url += '&product-code={{product_code}}';
                }
                location.href =  url;
            });
        });
    </script>
{% endblock %}

