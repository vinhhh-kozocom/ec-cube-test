{% extends 'default_frame.twig' %}
{% set body_class = 'cart_page' %}
{% block main %}
<div id="">
	<div class="aki-row">
		<div class="col-md-12 text-center">
			<h2 class="mb20">購入エラー</h2>
			<p>
				{{'front.reservation.errors'|trans}}<a class="color-primary" href="/contact">{{'front.reservation.errors_contact' | trans}} </a>
			</p>
			<p>
				{% for error in app.session.flashbag.get('eccube.front.error')  %}
				<div id="error_box__error_message-{{ loop.index }}" class="message">
					{{ error|trans|nl2br }}
				</div>
				{% endfor %}
			</p>
		</div>
	</div>
	<div class="col-md-12 mt30">
		<div class="aki-row">
			<div class="col-md-6 col-12 text-center text-md-end mb20">
				<a href="{{ url('homepage') }}" class="aki-btn aki-btn-default">{{ 'common.go_to_top'|trans }}</a>
			</div>
		</div>
	</div>
</div>
{% endblock %}
