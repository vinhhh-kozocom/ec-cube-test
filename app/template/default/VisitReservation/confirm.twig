{% extends 'default_frame.twig' %}
{% form_theme form 'Form/form_div_layout.twig' %}
{% block main %}
<div class="registration_page">
    <div class="aki-row mb30">
        <div class="col-12 text-center">
            <h2 class="mb20">お下見申込フォーム</h2>
        </div>
    </div>
    <div class="">
        <div class="">
            <form method="post" action="{{ url('visit_reservation') }}" class="h-adr">
                {{ form_widget(form._token) }}
                <div class="dl_table m-0">
                    <dl id="top_box__name">
                        <dt>
                            {{ form_label(form.store, '') }}
                        </dt>
                        <dd>
                            {{ form.store.vars.data }}
                            {{ form_widget(form.store, { type : 'hidden' }) }}
                        </dd>
                    </dl>
                </div>
                <div class="dl_table m-0">
                    <dl id="top_box__name">
                        <dt>
                            お下見の日付（第一希望）<span class="ec-required">*</span>
                        </dt>
                        <dd>
                            {{ form.first_visit_date.vars.data|date('Y/m/d') }} {{ form.first_visit_time.vars.data|date('H:i') }}
                            {{ form_widget(form.first_visit_date, { type: 'hidden' }) }}
                            {{ form_widget(form.first_visit_time, { type: 'hidden' }) }}
                        </dd>
                    </dl>
                    {% if form.second_visit_date.vars.data and form.second_visit_time.vars.data %}
                    <dl id="top_box__name">
                        <dt>
                            お下見の日付（第二希望）<span class="ec-required">*</span>
                        </dt>
                        <dd>
                            {{ form.second_visit_date.vars.data|date('Y/m/d') }} {{ form.second_visit_time.vars.data|date('H:i') }}
                            {{ form_widget(form.second_visit_date, { type: 'hidden' }) }}
                            {{ form_widget(form.second_visit_time, { type: 'hidden' }) }}
                        </dd>
                    </dl>
                    {% endif %}
                </div>
                {% if form.product_code.vars.data %}
                <div class="dl_table m-0">
                    <dl id="top_box__name">
                        <dt>
                            {{ form_label(form.product_code, '') }}
                        </dt>
                        <dd>
                            {{ form.product_code.vars.data }}
                            {{ form_widget(form.product_code, { type : 'hidden' }) }}
                        </dd>
                    </dl>
                </div>
                {% endif %}
                <div class="dl_table m-0">
                    <dl id="top_box__name">
                        <dt>
                            お名前<span class="ec-required">*</span>
                        </dt>
                        <dd>
                            {{ form.last_name.vars.data }} {{ form.first_name.vars.data }}
                            {{ form_widget(form.last_name, { type: 'hidden' }) }}
                            {{ form_widget(form.first_name, { type: 'hidden' }) }}
                        </dd>
                    </dl>
                    <dl id="top_box__name">
                        <dt>
                            お名前（フリガナ）<span class="ec-required">*</span>
                        </dt>
                        <dd>
                            {{ form.last_name_kana.vars.data }} {{ form.first_name_kana.vars.data }}
                            {{ form_widget(form.last_name_kana, { type: 'hidden' }) }}
                            {{ form_widget(form.first_name_kana, { type: 'hidden' }) }}
                        </dd>
                    </dl>
                </div>
                <div class="dl_table m-0 mb-5">
                    <dl id="top_box__name">
                        <dt>

                            {{ form_label(form.phone, '') }}
                        </dt>
                        <dd>
                            {{ form.phone.vars.data }}
                            {{ form_widget(form.phone, { type : 'hidden' }) }}
                        </dd>
                    </dl>
                    <dl id="top_box__name">
                        <dt>

                            {{ form_label(form.email, '') }}
                        </dt>
                        <dd>
                            {{ form.email.vars.data }}
                            {{ form_widget(form.email, { type : 'hidden' }) }}
                        </dd>
                    </dl>
                    {% if form.usage_date.vars.data %}
                    <dl id="top_box__name">
                        <dt>
                            {{ form_label(form.usage_date, '') }}

                        </dt>
                        <dd>
                            {{ form.usage_date.vars.data|date('Y/m/d') }}
                            {{ form_widget(form.usage_date, { type : 'hidden' }) }}
                        </dd>
                    </dl>
                    {% endif %}
                    {% if form.try_on_people.vars.data %}
                    <dl id="top_box__name">
                        <dt>
                            {{ form_label(form.try_on_people, '') }}

                        </dt>
                        <dd>
                            {{ form.try_on_people.vars.data }}
                            {{ form_widget(form.try_on_people, { type : 'hidden' }) }}
                        </dd>
                    </dl>
                    {% endif %}
                    {% if form.purpose.vars.data %}
                    <dl id="top_box__name">
                        <dt>
                            {{ form_label(form.purpose, '') }}
                        </dt>
                        <dd>
                            {{ form.purpose.vars.data }}
                            {{ form_widget(form.purpose, { type : 'hidden' }) }}
                        </dd>
                    </dl>
                    {% endif %}
                    {% if form.kimono_type.vars.data %}
                    <dl id="top_box__name">
                        <dt>
                            {{ form_label(form.kimono_type, '') }}
                        </dt>
                        <dd>
                            {{ form.kimono_type.vars.data }}
                            {{ form_widget(form.kimono_type, { type : 'hidden' }) }}
                        </dd>
                    </dl>
                    {% endif %}
                    {% if form.height.vars.data %}
                    <dl id="top_box__name">
                        <dt>
                            {{ form_label(form.height, '') }}
                        </dt>
                        <dd>
                            {{ form.height.vars.data }}
                            {{ form_widget(form.height, { type : 'hidden' }) }}
                        </dd>
                    </dl>
                    <dl id="top_box__name">
                        <dt>
                            {{ form_label(form.note_info_1, '') }}
                        </dt>
                        <dd>
                            {{ form.note_info_1.vars.data }}
                            {{ form_widget(form.note_info_1, { type : 'hidden' }) }}
                        </dd>
                    </dl>
                    {% endif %}
                </div>
                <div class="text-center">
                    <div class="aki-row aki-well align-items-center justify-content-center mb30">
                        <div class="col-md-6 text-md-end">
                            <button type="submit" class="aki-btn aki-btn-default" name="mode" value="back">{{
                                'common.back'|trans }}</button>
                        </div>
                        <div class="col-md-6 text-md-start">
                            <button type="submit" class="aki-btn aki-btn-primary" name="mode" value="complete">{{
                                'common.send'|trans }}</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}