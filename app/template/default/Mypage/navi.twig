{% set favorite = BaseInfo.option_favorite_product %}
<nav id="navi_list_box" class="aki-navi aki-tabs-block {% if favorite == 1 %}favorite{% endif %} mb30">
	<ul class="aki-navi-list aki-navs">
		<li class="aki-navi-item"><a class="aki-border aki-btn {% if mypageno|default('') == 'index' %}active{% endif %}" href="{{ url('mypage') }}">ご注文履歴</a></li>
