{% set isSalon = SALON_URL == app.request.server.get('SERVER_NAME') %}
{% set isJapan = app.request.locale == 'ja' %}

{% if Order.orderType == "visit" %}
	{{ Order.name01 }} {{ Order.name02 }} 様

	下記ご注文内容にお間違えがないかご確認下さい。

    後に店舗担当者より「ご注文確定メール」を送らせていただきます。
    ★本メールでは注文は確定しておりませんのでご注意ください★

    {% if not isSalon %}
	※銀行振込をご選択の場合は、お支払口座を確定メールにてお伝えいたします。
	{% endif %}

	************************************************
			　お支払情報
	************************************************
	ご注文番号：{{ Order.id }}
	{% if isSalon %}
		ご予約方法：{% if Order.orderType == 'fitting' %}試着サービス{% else %}着物レンタル {% endif %}
	{% else %}
		ご予約方法：来店着付けレンタル
		お支払い方法：{{ Order.payment_method }}
        {% if Order.Payment.id|default('') == CREDIT_CARD_ID %}
            {% if Order.creditcard_method == PAYMENT_INSTALLENT_METHOD %}
                ({{'aki.front.shopping.payment.method.installment'|trans}})
            {% else %}
                ({{'aki.front.shopping.payment.method.bulk'|trans}})
            {% endif %}
            {% if Order.creditcard_method == PAYMENT_INSTALLENT_METHOD %}
                <div>{{'aki.front.shopping.payment.method.paytime.select'|trans}} : {{Order.creditcard_paytime}}</div>
            {% endif %}
        {% endif %}
	{% endif %}
	メッセージ：{{ Order.message }}

	{% set index = 0 %}
	{% set actual_total_price = 0 %}
	{% set secure_pack_price = 0 %}
	{% for OrderDetail in Order.MergedProductOrderItems %}
		{% if OrderDetail.product_code == 'secure_pack' %}
			{% set secure_pack_price = OrderDetail.productClass.price02 + OrderDetail.productClass.price02*OrderDetail.tax_rate/100 %}
		{% endif %}
	{% endfor %}
	{% for OrderDetail in Order.MergedProductOrderItems %}
		{% if OrderDetail.product_code != 'secure_pack' %}
			{% set actual_total_price = actual_total_price + OrderDetail.productClass.price02 %}
			{% set actual_total_price = actual_total_price + OrderDetail.productClass.price02*OrderDetail.tax_rate/100 %}
			{% set addinfo = Order.orderDetailInfo[index] %}
			{% if addinfo.secure_pack|length  > 0 %}
				{% set actual_total_price = actual_total_price + secure_pack_price %}
			{% endif %}
			{% set index = index + 1 %}
		{% endif %}
	{% endfor %}
	-------------------------------------------------
	合　計(税込) {{ Order.payment_total|price }}
	※上記の料金はレンタル料金・安心パックの金額となっております。
	※ヘアー＆メイク、早朝料金、有料写真については完了メールにてご案内させていただきます。
	{% if BaseInfo.isOptionPoint %}
		============================================
		ご使用ポイント
		{{ Order.usePoint }} pt
		現在の所持ポイント
		{{ Customer.Point }} pt
		============================================
	{% endif %}
	{% set index = 0 %}
	{% set actual_total_price = 0 %}
	{% set secure_pack_price = 0 %}
	{% for OrderDetail in Order.MergedProductOrderItems %}
		{% if OrderDetail.product_code == 'secure_pack' %}
			{% set secure_pack_price = OrderDetail.productClass.price02 + OrderDetail.productClass.price02*OrderDetail.tax_rate/100 %}
		{% endif %}
	{% endfor %}
	{% for OrderDetail in Order.MergedProductOrderItems %}
		{% if OrderDetail.product_code != 'secure_pack' %}
			{% set actual_total_price = actual_total_price + OrderDetail.productClass.price02 %}
			{% set actual_total_price = actual_total_price + OrderDetail.productClass.price02*OrderDetail.tax_rate/100 %}
			{% set addinfo = Order.orderDetailInfo[index] %}

			************************************************
				ご利用内容
			************************************************

			商品コード：{{ OrderDetail.product_code }}
			商品名:	{{ OrderDetail.product_name }}  {{ OrderDetail.classcategory_name1 }}  {{ OrderDetail.classcategory_name2 }}
			{% if OrderDetail.price_inctax != 0 %}
				単価(税込)：{{ OrderDetail.price_inctax|price }}
				{% else %}
				単価(税込)： {{ calc_inc_tax(OrderDetail.productClass.price02, OrderDetail.tax_rate, OrderDetail.tax_rule_id)|price }}
			{% endif %}
			{% if addinfo.secure_pack|length  > 0 %}
				{% set actual_total_price = actual_total_price + secure_pack_price %}
				{% if not isSalon %}
					安心パック(税込)：{% if addinfo.secure_pack is iterable %}
										{% for secure_pack in addinfo.secure_pack %}
											{{secure_pack}}
										{% endfor %}
										{% else %}
											{{addinfo.secure_pack}}
									{% endif %}
				{% endif %}
			{% else %}
				{% if not isSalon %}
					安心パック(税込)：加入なし
				{% endif %}
			{% endif %}
			着付けご来店希望店舗：{{ addinfo.visit_store }}

			※店舗での受付時に現住所の確認できる身分証（免許証や保険証など）をご提示ください。ご提示いただけない場合は保証金を別途お預かりいたします。（浴衣・小紋5,000円、その他の着物1万円）

			ご利用日：{{ addinfo.wear_date|date('Y-m-d') }}
			ご出発予定時間：{{ addinfo.time_departure }}
			用途：{{ addinfo.purpose }}
			身長：{{ addinfo.body_height }}
			足のサイズ：{{ addinfo.foot_size }}
			年代：{{ addinfo.decade }}
			{% if addinfo.body_type|length  > 0 %}
				体型：
				{% for body_type in addinfo.getBodyTypeJsonDecode() %}
					{{body_type}}
				{% endfor %}
			{% endif %}

			フォト：{{ addinfo.need_photo }}
			ヘア・メイクの有無：{{ addinfo.need_hair_make }}

			{% set index = index + 1 %}
		{% endif %}
	{% endfor %}
	************************************************
    　ご注文者情報
    ************************************************

	お名前　：{{ Order.name01 }} {{ Order.name02 }} 様
	フリガナ：{{ Order.kana01 }}{{ Order.kana02 }}
	{% if Order.company_name %}
		会社名　：{{ Order.company_name }}
	{% endif %}
    {% if isJapan %}
        郵便番号：〒{{ Order.postal_code }}
        住所　　：{{ Order.Pref.name }}{{ Order.addr01 }}{{ Order.addr02 }}
    {% endif %}
	電話番号：{{ Order.phone_number }}
    {% if isJapan %}
	    FAX番号：{{ Order.fax }}
    {% endif %}
	メールアドレス：{{ Order.email }}
	************************************************

