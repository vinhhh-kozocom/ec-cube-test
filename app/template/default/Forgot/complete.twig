{% extends 'default_frame.twig' %} {% block main %}
<div>
    <div class="aki-row">
        <div class="col-12 text-center">
            <h2>{{ "aki-forgot-complete" | trans }}</h2>
            <p class="mt20 text-start text-md-center">
                {{ "aki-forgot-complete-top" | trans }}<br>{{ "aki-forgot-complete-bottom" | trans }}
            </p>
        </div>
    </div>

    <div id="contents" class="main_only mt20">
        <div>
            <div id="complete_wrap">
                <div id="complete_box" class="row">
                    <div id="complete_box__body" class="col-md-10 offset-md-1">
                        <div
                            id="complete_box__message"
                            class="complete_message"
                        >
                            <h2>
                                {{
                                    "front.forgot.complete_message__title"
                                        | trans
                                }}
                            </h2>
                            <p class="mt20 text-start text-md-center">
                                {{
                                    "front.forgot.complete_message__body"
                                        | trans
                                }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
