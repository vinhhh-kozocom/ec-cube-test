<body id="page_{{ app.request.get('_route') }}" class="{{ body_class|default('other_page') }}">
    {% set isJapan = app.request.locale == LOCALE_JAPAN %}
    {% set isEnglish = app.request.locale == LOCALE_ENGLISH %}
    {% set isChina = app.request.locale == LOCALE_CHINA %}
    {% if not isJapan %}
        {% set isJapan = 0 %}
    {% endif %}
    {% if not isEnglish %}
        {% set isEnglish = 0 %}
    {% endif %}
    {% if not isChina %}
        {% set isChina = 0 %}
    {% endif %}
     <div id="wrapper">
        <header id="header" {% if not Layout.Header %}class="hidden_space_header"{% endif %}>
            {# ▼HeaderInternal COLUMN #}
            {% if Layout.Header %}
            {# ▼上ナビ #}
            {{ include('block.twig', {'Blocks': Layout.Header}) }}
            {# ▲上ナビ #}
            {% endif %}
            {# ▲HeaderInternal COLUMN #}
        </header>

        <article id="contents">
            {% if isSalon %}
            <div id="contents_top">
            {% else %}
            <div id="contents_top" {% if Layout.Header %}class="mb40"{% endif %}>
            {% endif %}
                {# ▼TOP COLUMN #}
                {% if Layout.ContentsTop %}
                {# ▼上ナビ #}
                {{ include('block.twig', {'Blocks': Layout.ContentsTop}) }}
                {# ▲上ナビ #}
                {% endif %}
                {# ▲TOP COLUMN #}
            </div>
            <div class="aki-container">
                <div class="aki-row banner-top-page">
                    {# ▼LEFT COLUMN #}
                    {% if Layout.SideLeft %}
                    <aside id="" class="col-md-3 side">
                        {# ▼左ナビ #}
                        {{ include('block.twig', {'Blocks': Layout.SideLeft}) }}
                        {# ▲左ナビ #}
                    </aside>
                    {% endif %}
                    {# ▼LEFT COLUMN #}

                    {% if isSalon %}
                    <div id="" class="mt20 col-md-9">
                    {% else %}
                    <div id="" class="col-md-9">
                    {% endif %}
                        {# ▼メイン上部 #}
                        {% if Layout.MainTop %}
                        <div id="main_top">
                            {{ include('block.twig', {'Blocks': Layout.MainTop}) }}
                        </div>
                        {% endif %}
                        {# ▲メイン上部 #}

                        <div id="main_middle">
                            {% block main %}{% endblock %}
                        </div>

                        {# ▼メイン下部 #}
                        {% if Layout.MainBottom %}
                            <div id="main_bottom">
                            {{ include('block.twig', {'Blocks': Layout.MainBottom}) }}
                            </div>
                        {% endif %}
                        {# ▲メイン下部 #}
                    </div>
                </div>
                <div id="contents_bottom">
                    {# ▼BOTTOM COLUMN #}
                    {% if Layout.ContentsBottom %}
                    {# ▼下ナビ #}
                    {{ include('block.twig', {'Blocks': Layout.ContentsBottom}) }}
                    {# ▲下ナビ #}
                    {% endif %}
                    {# ▲BOTTOM COLUMN #}
                </div>
            </div>
        </article>

        <footer id="footer" class="footer_link">
            {# ▼Footer COLUMN#}
            {% if Layout.Footer %}
            {# ▼上ナビ #}
            {{ include('block.twig', {'Blocks': Layout.Footer}) }}
            {# ▲上ナビ #}
            {% endif %}
            {# ▲Footer COLUMN#}
        </footer>
        <div id="drawer" class="drawer sp"></div>
    </div>

<div class="overlay"></div>

