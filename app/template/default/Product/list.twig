												</div>
												<div class="checkbox">
													<label><input type="checkbox" name="category_id_1[]" value="190" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '大きいサイズ(女性174cm以上/男性181cm以上)'});">大きいサイズ(女性174cm以上/男性181cm以上)</label>
												</div>
											</div>
										</div>
									</div>
									<div class="col-md-6 col-12">
										<div class="panel panel-default">
											<div class="panel-background_white panel-body aki-border">
												<div class="mb20 fw-bold">イメージ</div>
												<div class="checkbox">
													<label class="checkbox-inline"><input type="checkbox" name="category_id_2[]" value="198" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': 'かわいい'});">かわいい</label>
													<label class="checkbox-inline"><input type="checkbox" name="category_id_2[]" value="199" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '華やか'});">華やか</label>
													<label class="checkbox-inline"><input type="checkbox" name="category_id_2[]" value="200" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': 'おしとやか'});">おしとやか</label>
													<label class="checkbox-inline"><input type="checkbox" name="category_id_2[]" value="201" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '古典'});">古典</label>
												</div>
											</div>
										</div>
										<div class="panel panel-default">
											<div class="panel-background_white panel-body aki-border">
												<div class="mb20 fw-bold">カラー</div>
												<div class="checkbox">
													<label class="checkbox-inline"><input type="checkbox" name="category_id_3[]" value="175" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '青・紺・水色'});">青・紺・水色</label>
													<label class="checkbox-inline"><input type="checkbox" name="category_id_3[]" value="176" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '赤・ピンク・紫'});">赤・ピンク・紫</label>
													<label class="checkbox-inline"><input type="checkbox" name="category_id_3[]" value="177" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '白'});">白</label>
													<label class="checkbox-inline"><input type="checkbox" name="category_id_3[]" value="192" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '黄色・オレンジ'});">黄色・オレンジ</label>
													<label class="checkbox-inline"><input type="checkbox" name="category_id_3[]" value="193" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '緑'});">緑</label>
													<label class="checkbox-inline"><input type="checkbox" name="category_id_3[]" value="194" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '黒'});">黒</label>
													<label class="checkbox-inline"><input type="checkbox" name="category_id_3[]" value="195" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': 'グレー'});">グレー</label>
													<label class="checkbox-inline"><input type="checkbox" name="category_id_3[]" value="196" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': 'クリーム・ベージュ・茶色'});">クリーム・ベージュ・茶色</label>
												</div>
											</div>
										</div>
										{% if not isSalon %}
											<div class="panel panel-default">
												<div class="panel-background_white panel-body aki-border mb-20-md">
													<div class="mb20 fw-bold">取扱店舗</div>
													<div class="checkbox">
														<label class="checkbox-inline"><input type="checkbox" name="category_id_4[]" value="217" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '渋谷本店'});">渋谷本店</label>
														<label class="checkbox-inline"><input type="checkbox" name="category_id_4[]" value="218" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '銀座店'});">銀座店</label>
														<label class="checkbox-inline"><input type="checkbox" name="category_id_4[]" value="219" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '池袋店'});">池袋店</label>
														<label class="checkbox-inline"><input type="checkbox" name="category_id_4[]" value="220" onclick="gtag('event', 'クリック', {'event_category': '条件検索分岐','event_label': '横浜店'});">横浜店</label>
													</div>
												</div>
											</div>
										{% endif %}
									</div>
									<div class="col-12 text-center">
										<div class="aki-row aki-well align-items-center">
											<div class="col-md-6 text-md-end">
												<p class="aki-btn aki-btn-default aki-btn-refresh"><i class="aki-icon-refresh"></i> 検索条件をクリア</p>
											</div>
											<div class="col-md-6 text-md-start">
												<button id="filter_button_search" class="aki-btn aki-btn-primary" onclick="gtag('event', 'クリック', {'event_category': '条件検索関連','event_label': '選択した条件で検索ボタン'});">
													<img loading="lazy" src="{{ asset('assets/icon/search-white.svg') }}" class="aki-icon-default" alt="icon"/>
													選択した条件で検索</button>
											</div>
										</div>
									</div>
								</div>

							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="product">
			<div class="row pb00">
				<div id="topicpath" class="col-md-5 col-md-12 mt05">
					<ol id="list_header_menu" class="mb00 product_top">
						{# <li>
							<a href="{{ url('product_list') }}">全商品</a>
						</li> #}
						{% if Category is not null %}
							{% for Path in Category.path %}
								<li>
									<a href="{{ url('product_list') }}?category_id={{ Path.id }}">{{ Path.name }}</a>
								</li>
							{% endfor %}
						{% endif %}
						{% if search_form.vars.value.name %}
							<li>「{{ search_form.vars.value.name }}」の検索結果</li>
						{% endif %}
						<li><a href="/products/list">全商品　</a><strong><span id="productscount">{{ pagination.totalItemCount }}</span>件</strong>の商品</li>
						<li>
							<div class="pb00 product_title">
								<span class="gray-sub-text">並べ替え</span>
								<div class="pl00 position-relative custom_arrow_select">
									{{ form_widget(order_by_form, {'id': '', 'attr': {'onchange': "javascript:fnChangeOrderBy(this.value);"}}) }}
								</div>
							</div>
						</li>
					</ol>
				</div>
				{% if pagination.totalItemCount and pagination.totalItemCount is not null %}
				<div class="col-12">
					<div class="product_pager">
						<div class="product_pager_all-count">
							<span class="">表示件数: </span>
							<div class="disp_number_form position-relative custom_arrow_select">
								{{ form_widget(disp_number_form, {'id': '', 'class':'form-control','attr': {'onchange': "javascript:fnChangeDispNumber(this.value);"}}) }}
							</div>
						</div>
						<div class="ec-pagerRole">
							{% include "pager.twig" with {'pages': pagination.paginationData} %}
						</div>
					</div>
				</div>
				{% endif %}
			</div>
		</div>
		<div id="item_list">
			<ul
				class="thumbnails list-unstyled row">
				{% for Product in pagination %}
                    <li id="result_list_box--{{ Product.id }}" class="col-md-3 col-6 list_product">
                            <div class="thumbnail" id="result_list__detail--{{ Product.id }}">
                                <a href="{{ url('product_detail', {'id': Product.id}) }}">
                                    <div class="inline_block_before">
                                        <img loading="lazy" src="{{ asset(Product.main_list_image|no_image_product, 'save_image') }}" alt="{{ Product.name }}" class="img-responsive" {% if loop.index > 5 %} loading="lazy"{% endif %}>
                                    </div>
                                </a>
                                <div class="caption">
                                    {% if Product.ProductTag is not empty %}
                                        <!--▼商品タグ-->
                                        <div id="product_tag_box" class="product_tag text-center mt-10">
                                            {% for ProductTag in Product.ProductTag %}
                                                <div id="product_tag_box__product_tag--{{ ProductTag.Tag.id }}" class="new-tag">
                                                    {{ ProductTag.Tag.name }}
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                    <h3 id="result_list__name--{{ Product.id }}">
                                {% if __EX_PRODUCT_LIST[Product.id][5] is defined %}
                                    {% if __EX_PRODUCT_LIST[Product.id][5].value is not empty %}
                                        {% if __EX_PRODUCT_LIST[Product.id][5].value.value != LOCALE_JAPAN and __EX_PRODUCT_LIST[Product.id][5].value.value != '' %}
                                            <a href="{{ url('product_detail_locale', {'id': Product.id, '_locale':  __EX_PRODUCT_LIST[Product.id][5].value.value}) }}">{{ Product.name }}</a>
                                        {% else %}
                                            <a href="{{ url('product_detail', {'id': Product.id}) }}">{{ Product.name }}</a>
                                        {% endif %}
                                    {% else %}
                                        <a href="{{ url('product_detail', {'id': Product.id}) }}">{{ Product.name }}</a>
                                    {% endif %}
                                {% else %}
                                    <a href="{{ url('product_detail', {'id': Product.id}) }}">{{ Product.name }}</a>
                                {% endif %}
                                    </h3>
                                    <ul class="caption-price">
                                        {% if Product.hasProductClass %}
                                            {% if Product.getPrice02Min == Product.getPrice02Max %}
                                                <li>
                                                    <strong id="result_list__price02_inc_tax--{{ Product.id }}">kore{{ Product.getPrice02IncTaxMin|price }}</strong>
                                                </li>
                                            {% else %}
                                                <li>
                                                    <strong id="result_list__price02_inc_tax--{{ Product.id }}">{{ Product.getPrice02IncTaxMin|price }}
                                                        ～
                                                        {{ Product.getPrice02IncTaxMax|price }}
                                                    </strong>
                                                </li>
                                            {% endif %}
                                        {% else %}
                                            <li>
                                                <strong id="result_list__price02_inc_tax--{{ Product.id }}">{{ Product.getPrice02IncTaxMin|number_format }}円</strong>
                                            </li>
                                        {% endif %}
                                        {% if __EX_PRODUCT_LIST is defined %}
                                            <li>&nbsp;</li>
                                                {% if (__EX_PRODUCT_LIST[Product.id][4]['value']) %}
                                                    <li>素材:{{__EX_PRODUCT_LIST[Product.id][4]['value'].value}}</li>
                                                {% else %}
                                                    <li>&nbsp;</li>
                                                {% endif %}
                                            <li>&nbsp;</li>
                                        {% endif %}
                                        <li>商品コード :
                                            <span id="item_code_default" data-id="{{ Product.id }}">{{ Product.code_min }}
                                                {% if Product.code_min != Product.code_max %}
                                                    ～
                                                    {{ Product.code_max }}
                                                {% endif %}
                                            </span>
                                        </li>
										{% if not isSalon %}
											<li>
												{% if Product.belongsToCategory(217) %}
													取扱店舗 :<a class="text-green text-decoration-underline" href="/user_data/shop/shibuya">渋谷本店</a>
												{% elseif Product.belongsToCategory(218) %}
													取扱店舗 :<a class="text-green text-decoration-underline" href="/user_data/shop/ginza">銀座店</a>
												{% elseif Product.belongsToCategory(219) %}
													取扱店舗 :<a class="text-green text-decoration-underline" href="/user_data/shop/ikebukuro">池袋店</a>
												{% elseif Product.belongsToCategory(220) %}
													取扱店舗 :<a class="text-green text-decoration-underline" href="/user_data/shop/yokohama">横浜店</a>
												{% else %}
												{% endif %}
											</li>
										{% endif %}
                                    </ul>
                                </div>
                            </div>
                    </li>
				{% endfor %}
			</ul>
		</div>
		{% if pagination.totalItemCount and pagination.totalItemCount is not null %}
		<div class="product">
			<div class="row pb00">
				<div class="col-12">
					<div class="product_pager">
						<div class="product_pager_all-count product_pager_all-count_down">
							<span>表示件数: </span>
						</div>
						<div class="ec-pagerRole">
							{% include "pager.twig" with {'pages': pagination.paginationData} %}
						</div>
					</div>
				</div>
			</div>
		</div>
		{% endif %}
	</form>


{% endblock %}
{% block javascript %}
<script>

	$(window).on('load', function() {
		$('.aki-btn-refresh').click(function() {
			$('#search_filter_1 input').prop('checked', false);
		});
		if($('.product_pager_all-count_down').length > 0){
			$('.product_pager_all-count_down').append( $('.disp_number_form')[0].outerHTML)
		}
	})

	// 並び順を変更
	function fnChangeOrderBy(orderby) {
		eccube.setValue('orderby', orderby);
		eccube.setValue('pageno', 1);
		eccube.submitForm();
	}

	// 表示件数を変更
	function fnChangeDispNumber(dispNumber) {
		eccube.setValue('disp_number', dispNumber);
		eccube.setValue('pageno', 1);
		eccube.submitForm();
	}

	$(document).ready(function() {
		$('#filter_button_search').on('click', function(event) {
			const specialUrl = [
				'big',
				'hitoenatu'
			]
			const category = $('.category_id_side').val();
			const calendar = $('#AkiuseDateSideForm').val();
			if (specialUrl.includes(category)) {
				event.preventDefault();
				const newUrl = `/user_data/${category}?category_id=${category}${calendar ? `&date=${calendar}` : ''}`;
				window.location.href = newUrl;
			}
		});
	});
	</script>
	{% if app.request.get('category_id_0') or app.request.get('category_id_1') or app.request.get('category_id_2') or app.request.get('category_id_3') or app.request.get('category_id_4') %}
		<script>
			$('#search_filter a').removeClass('collapsed');
			$('#search_filter_1').addClass('in');
			// Check selected checkbox in search filter
			$checked_id = [];{% if app.request.get('category_id_0') %}{% for id in app.request.get('category_id_0') %}$checked_id.push('{{ id }}');{% endfor %}{% endif %}{% if app.request.get('category_id_1') %}
			{% for id in app.request.get('category_id_1') %}
			$checked_id.push('{{ id }}');{% endfor %}{% endif %}{% if app.request.get('category_id_2') %}
			{% for id in app.request.get('category_id_2') %}
			$checked_id.push('{{ id }}');{% endfor %}{% endif %}{% if app.request.get('category_id_3') %}
			{% for id in app.request.get('category_id_3') %}
			$checked_id.push('{{ id }}');{% endfor %}{% endif %}{% if app.request.get('category_id_4') %}
			{% for id in app.request.get('category_id_4') %}
			$checked_id.push('{{ id }}');{% endfor %}{% endif %}$('#search_filter_1 .checkbox input').each(function () {
			if ($.inArray($(this).val(), $checked_id) !== -1) {
			$(this).prop('checked', true);
			}
			});
		</script>
	{% endif %}
{% endblock %}
