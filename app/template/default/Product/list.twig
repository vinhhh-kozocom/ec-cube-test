								<a role="button" data-bs-toggle="collapse" data-bs-parent="#accordion_search" href="#search_filter_1" aria-expanded="true" aria-controls="search_filter_1" class="fas fa-plus" onclick="gtag('event', 'クリック', {'event_category': '条件検索関連','event_label': '条件検索を開くボタン'});">
