{% extends 'default_frame.twig' %}
{% set body_class = 'registration_page' %}
{% block main %}
<div id="">
	<div class="aki-row">
		<div class="col-12 text-center">
			<h2 class="mb20">新規会員登録（完了）</h2>
		</div>
	</div>

	<div id="activate_box" class="text-center">
		<div id="activate_box__body" class="col-md-10 offset-md-1">
			<div id="activate_box__message" class="complete_message mb20">
				<h3 class="mb20">本登録が完了いたしました。</h3>
				<p>それではショッピングをお楽しみください。<br>
				今後ともご愛顧賜りますようよろしくお願い申し上げます。</p>
			</div>
			<div id="activate_box__footer" class="row no-padding">
				<div id="activate_box__button_menu" class="btn_group offset-md-4 col-md-4">
					<p id="activate_box__top_button" >
						<a href="{{ url('homepage') }}" class="aki-btn aki-btn-primary">{{ 'common.go_to_top'|trans }}</a>
					</p>
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}
