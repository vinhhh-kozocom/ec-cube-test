	h2.error {
	font-size:2.5rem;
	position: relative;
	color:white;
	padding: .75em 1em;
	background-color: #4c996d;
	}
	h2.error::before,
	h2.error::after {
	content: '';
	position: absolute;
	top: 100%;
	border-style: solid;
	border-color: transparent;
	}
	h2.error::before {
	left: 0;
	border-width: 0 15px 15px 0;
	border-right-color: #1f8048;
	}
	h2.error::after {
	right: 0;
	border-style: solid;
	border-width: 15px 15px 0 0;
	border-top-color: #1f8048;
	}
	.body-studio{
		min-height: calc(100vh - 246.52px) !important;
	}
	.is-d-none{
		display:none;
	}
	@media(max-width: 768px){
        .body-studio{
			min-height: calc(100vh - 254.55px) !important;
		}
    }
</style>

