{% extends 'default_frame.twig' %}

{% form_theme form 'Form/form_div_layout.twig' %}

{% block stylesheet %}
    <style>
    .cart_item .item_box > .td {
        border-bottom: 1px dotted #ccc;
    }
    .table > :not(:first-child) {
        border-top: 0px;
    }
    .text-primary {
        color: #4d90fe;
    }
    .ec-totalBox .ec-totalBox__spec{
        margin-bottom: 12px;
    }
    .total_amount{
        margin-top: 16px;
        border-top: 1px dotted #ccc;
        text-align: right;
        font-weight: 700;
    }
    .total_price strong{
        font-size: 24px;
    }
    .ec-input input[type="number"] {
        text-align: left;
        font-size: 14px;
    }
    .customer-form input{
        width: 100% !important;
    }
    .ec-halfInput input, .ec-zipInput input{
        font-size: 14px;
    }
    @media(max-width: 768px){
        .ec-halfInput input{
            margin-bottom: 0px;
        }
        .ec-halfInput-custom span:first-child input, .ec-zipInput input{
            margin-bottom: 20px;
        }
    }
    .option_paytime{
        text-align: center;
        height: 26px;
        width: 50px;
        margin-left: 10px;
        padding: 0;
        cursor: pointer;
        margin-top: -4px;
    }
    .label_payment-method,
    .paytime_label {
        margin-top:-2px;
    }
</style>
{% endblock %}

{% block javascript %}
    <script src="https://www.google.com/recaptcha/api.js"></script>
    <script>
        $(function() {
            var $redirectCallback = function() {
                loadingOverlay();
                $('#shopping_order_redirect_to').val($(this).attr('data-path'));
                $('#shopping-form').attr('action', '{{ url( not isJapan ? "shopping_redirect_to_locale" : "shopping_redirect_to") }}').submit();
                setTimeout(function () {
                    loadingOverlay("hide");
                }, 2000);
            };
            $('[data-trigger]').each(function() {
                $(this).on($(this).attr('data-trigger'), $redirectCallback);
            });

            {% if is_granted('ROLE_USER') == false %}
            var edit = $('.customer-edit');
            var hidden = $('.customer-in');
            var form = $('.customer-form');
            $('#customer').click(function() {
                $(edit).each(function(index) {
                    var name = $(this).text();
                    var input = $('<input id="edit' + index + '" type="text" />').val(name);
                    $(form[index]).empty().append(input);
                });

                $('.non-customer-display').hide();
                $('.non-customer-edit').show();
                $('.mod-button').show();
            });

            $('#customer-ok').click(function() {
                $(form).each(function(index) {
                    $(hidden[index]).val($(form[index]).children('input').val());
                });

                var postData = {};
                $(hidden).each(function() {
                    postData[$(this).attr('name')] = $(this).val();
                });

                loadingOverlay();

                $.ajax({
                    url: "{{ url(not isJapan ? 'shopping_customer_locale' : 'shopping_customer') }}",
                    type: 'POST',
                    data: postData,
                    dataType: 'json'
                }).done(function(data) {
                    if (data.status == 'OK') {
                        $(form).each(function(index) {
                            $(edit[index]).empty().text($(form[index]).children('input').val());
                            $(form[index]).empty();
                        });
                        // kana field
                        if({{isJapan}}){
                            $(edit[2]).empty().text(data.kana01);
                            $(edit[3]).empty().text(data.kana02);
                            $('#customer-kana01').val(data.kana01);
                            $('#customer-kana02').val(data.kana02);
                        }
                    }
                }).fail(function(data) {
                    let key = Object.values(data?.responseJSON?.error?.violations[0]?.parameters)
                    let value = data?.responseJSON?.error?.violations[0]?.title
                    if(key && value){
                        alert(key + ' ' + value);
                    }else{
                        alert('更新に失敗しました。入力内容を確認してください。');
                    }

                }).always(function(data) {
                    // overlayを無効
                    loadingOverlay('hide');
                });

                $('.non-customer-display').show();
                $('.non-customer-edit').hide();
                $('.mod-button').hide();
            });

            $('#customer-cancel').click(function() {
                $('.non-customer-display').show();
                $('.non-customer-edit').hide();
                $('.mod-button').hide();
            });
            {% endif %}
            if(!{{isJapan}}){
                $('.ec-orderPayment span').each(function() {
                    if ($(this).text() == 'クレジットカード') {
                        if({{isEnglish}}){
                            $(this).text('Credit card');
                        }else{
                             $(this).text('信用卡');
                        }
                    }
                    if ($(this).text() == '銀行振込') {
                        $(this).text('Bank transfer');
                    }
                });
            }
            if($('.ec-orderPayment input[checked="checked"]').next()[0].innerText == '{{'aki.front.cart.title.order.bank.transfer'|trans}}'){
                $('.text-sub-title').text('{{'aki.front.cart.title.order'|trans}}')
                $('.prevention-mask').text('{{'aki.front.cart.button.order'|trans}}')
            }

            $('input[name="_shopping_order[Payment]"]').each(function() {
                if ($(this).attr('id') !== 'shopping_order_Payment_20') {
                    $(this).on('change', function() {
                        $('.credit_card-method').hide();
                    });
                }
            });

            if($('#shopping_order_Payment_20').is(':checked')){
                $('.credit_card-method').show();
            }
            else{
                $('.credit_card-method').hide();
            }
            function updateVisibility() {
                if ($('#installment').is(':checked')) {
                    $('.paytime_label, #option_paytime').show();
                } else {
                    $('.paytime_label, #option_paytime').hide();
                }
            }
            updateVisibility()
            $('input[name="method"]').change(function() {
                updateVisibility();
            });
            $(window).on('pageshow', function(event) {
                updateVisibility();
            });
        });
    </script>
{% endblock javascript %}

{% block main %}
    <div class="row">
        <div class="col-md-12 text-center">
            <h2 class="mb20">{{ 'front.shopping.title'|trans }}</h2>
            {% if isSalon %}
                <p class="text-sub-title">ご注文内容と配送先をご確認の上、「確認する」ボタンをクリックしてください。</p>
            {% else %}
                <p class="text-sub-title">{{ 'aki.front.shopping.shipping_sub_title'|trans }}</p>
            {% endif %}
        </div>
    </div>

    <div class="">
        <ul class="ec-progress">
            {% set step = 1 %}
            <li class="ec-progress__item">
                <div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
                </div>
                <div class="ec-progress__label">{{ 'front.cart.nav__cart_items'|trans }}
                </div>
            </li>
            {% if is_granted('ROLE_USER') == false %}
                <li class="ec-progress__item">
                    <div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
                    </div>
                    <div class="ec-progress__label">{{ 'front.cart.nav__customer_info'|trans }}
                    </div>
                </li>
            {% endif %}
            <li class="ec-progress__item is-complete">
                <div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
                </div>
                <div class="ec-progress__label">{{ 'front.cart.nav__order'|trans }}
                </div>
            </li>
            <li class="ec-progress__item">
                <div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
                </div>
                <div class="ec-progress__label">{{ 'front.cart.nav__confirm'|trans }}
                </div>
            </li>
            <li class="ec-progress__item">
                <div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
                </div>
                <div class="ec-progress__label">{{ 'front.cart.nav__complete'|trans }}
                </div>
            </li>
        </ul>

        <!-- アラートメッセージ -->
        {{ include('Shopping/alert.twig') }}
    </div>

    <form id="shopping-form" method="post" class="shipping-flow" action="{{ url(not isJapan ? 'shopping_confirm_locale' : 'shopping_confirm') }}">
        {{ form_widget(form._token) }}
        {{ form_widget(form.redirect_to) }}
