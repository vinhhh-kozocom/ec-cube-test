                                    {# 安心パック #}
                                {% else %}
                                    {% if OrderDetailAdditionalInfoList[index] is defined and OrderDetailAdditionalInfoList[index] is not null %}
                                        {% set addinfo = OrderDetailAdditionalInfoList[index] %}
                                        <div id="cart_box_list__item_box--{{ loop.index }}" class="history-block-item">
                                            <div id="cart_box_list__item--{{ loop.index }}" class="d-flex">
                                                <div id="cart_box_list__photo--{{ loop.index }}" class="item_photo"><img loading="lazy" src="{{ asset((orderItem.product is null ? null : orderItem.product.MainListImage)|no_image_product, 'save_image') }}" alt="{{ orderItem.productName }}" /></div>
                                                <dl id="cart_box_list__detail--{{ loop.index }}">
                                                    <dd id="cart_box_list__name--{{ loop.index }}" class="text-default gray-sub-text">{{ orderItem.productName }}</dd>
                                                    <dd id="cart_box_list__price--{{ loop.index }}" class="gray-sub-text fw-bold mt10 mb10">{{ orderItem.priceIncTax|price }}</dd>
                                                    {% if isSalon %}
