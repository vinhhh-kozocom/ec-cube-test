                                            <div class="ec-select d-none">
                                                <label>{{ 'front.shopping.delivery_provider'|trans }}</label>
                                                {{ form_widget(form.Shippings[idx].Delivery, { 'attr': { 'class': 'form-control', 'data-trigger': 'change' }}) }}
                                                {{ form_errors(form.Shippings[idx].Delivery) }}
                                            </div>
                                            <div>
                                                <p>お届け日はご利用日の2日前となります。<br>
                                                {{ 'front.shopping.delivery_time'|trans }}</p><br>
                                                <div class="position-relative custom_arrow_select">
                                                    {{ form_widget(form.Shippings[idx].DeliveryTime, {'attr': {'class': 'form-control w-100'}}) }}
                                                    {{ form_errors(form.Shippings[idx].DeliveryTime) }}
                                                </div>
                                                </div>
                                        </div>
                                        </div>
                                    {% endfor %}

                                </div>
							{# according AKI_D spec, it will have problem when use multiple shipping => display:none #}
							<div class="ec-orderDelivery__edit d-none">
								<button type="button" class="ec-inlineBtn" data-trigger="click" data-path="{{ path('shopping_shipping_multiple') }}">{{ 'front.shopping.to_multiple'|trans }}</button>
							</div>
						</div>
                {% set options_paytime = PAYMENT_METHOD_SPLIT_OPTIONS %}
                <div class="ec-orderPayment" {% if isSalon %} style="display:none" {% endif %}>
                    <h3 class="mb20">{{ 'front.shopping.payment_info'|trans }}</h3>
                    <div class="history-block">
                        {% for key, child in form.Payment %}
                            {% if isJapan %}
                                <div {% if loop.index != 1 %} class="mt10" {% endif %}>
                                    {% set Payment = form.Payment.vars.choices[key].data %}
                                    {{ form_widget(child, { 'attr': { 'data-trigger': 'change' }}) }}
                                        {% if key == CREDIT_CARD_ID %}
                                            <div class="credit_card-method ms-5 mt-2">
                                                <div class='d-flex'>
                                                    <input name="method" checked id='bulk' type="radio" value="1"> <label class="ms-1 label_payment-method" for="bulk">{{'aki.front.shopping.payment.method.bulk'|trans}}</label>
                                                    <input name="method" id='installment' type="radio" value="2"> <label class="ms-1 label_payment-method" for="installment">{{'aki.front.shopping.payment.method.installment'|trans}}</label>
                                                    <span class="ms-4 paytime_label">{{'aki.front.shopping.payment.method.paytime.select'|trans}}:</span>
                                                    <select name="option_paytime" id="option_paytime" class="form-control option_paytime">
                                                        {% for item in options_paytime %}
                                                            <option value={{item}}>{{item}}</option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% if Payment.payment_image is not null %}
                                        <p><img loading="lazy" src="{{ asset(Payment.payment_image, 'save_image') }}"></p>
                                    {% endif %}
                                </div>
                            {% else %}
                                {% if key == CREDIT_CARD_ID %}
                                    <div {% if loop.index != 1 %} class="mt10" {% endif %}>
                                        {% set Payment = form.Payment.vars.choices[key].data %}
                                        {{ form_widget(child, { 'attr': { 'data-trigger': 'change' }}) }}
                                        {% if Payment.payment_image is not null %}
                                            <p><img loading="lazy" src="{{ asset(Payment.payment_image, 'save_image') }}"></p>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    </div>
                    <div class="ec-input {{ has_errors(form.Payment) ? ' error' }}">{{ form_errors(form.Payment) }}</div>
                </div>
                {% if BaseInfo.isOptionPoint and Order.Customer is not null %}
                    <div class="ec-orderPayment">
                        <h3 class="mb20">{{ 'front.shopping.point_info'|trans }}</h3>
                        <div class="history-block">
                            <p>{{ 'front.shopping.available_point'|trans({ '%point%': Order.Customer.Point|number_format }) }}</p>
                            {{ form_widget(form.use_point, { 'attr': { 'type': 'text', 'class': 'form-control', 'data-trigger': 'change' }}) }}
                            {{ form_errors(form.use_point) }}
                        </div>
                    </div>
                {% endif %}
                <div class="ec-orderConfirm">
                    <h3 class="mb20">{{ 'front.shopping.message_info'|trans }}</h3>
                    <div class="history-block">
                        <div class="column">
                            {{ form_widget(form.message, {'attr': {'class': 'form-control', 'placeholder': 'front.shopping.message_placeholder'|trans, 'rows': '6'}}) }}
                            {{ form_errors(form.message) }}
                        </div>
                    </div>
                </div>
                {% for activeTradeLaw in activeTradeLaws|filter(t => t.name and t.description) %}
                    <div class="ec-orderConfirm">
                        <h3 class="mb20">{{ activeTradeLaw.name }}</h3>
                        <div class="ec-input">
                            {{ activeTradeLaw.description|raw }}
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="col-md-4 col-12">
                <div class="history-price">
                    <div class="ec-totalBox aki-alert-primary">
                        <dl class="ec-totalBox__spec">
                            <dt>{{ 'common.subtotal'|trans }}</dt>
                            <dd class="ec-totalBox__specTotal color-primary">{{ Order.subtotal|price }}</dd>
                        </dl>
                        <dl class="ec-totalBox__spec">
                            <dt>{{ 'common.charge'|trans }}</dt>
                            <dd>{{ Order.charge|price }}</dd>
                        </dl>
                        {% if isJapan %}
                            <dl class="ec-totalBox__spec">
                                <dt>{{ 'common.delivery_fee'|trans }}</dt>
                                <dd>{{ Order.deliveryFeeTotal|price }}</dd>
                            </dl>
                        {% endif %}
                        <dl class="ec-totalBox__spec" id="summary_box__shop_price" style="display:none;">
                            <dt>ご来店時支払い</dt>
                            <dd>&yen; <span>0</span></dd>
                        </dl>
                        {% if Order.taxable_discount < 0 %}
                        <dl class="ec-totalBox__spec">
                            <dt>{{ 'common.discount'|trans }}</dt>
                            <dd>{{ Order.taxable_discount|price }}</dd>
                        </dl>
                        {% endif %}
                        {% if not isSalon %}
                            {% if isJapan %}
                                <p class="mb20">{{'aki.front.cart.title.warnig'|trans}}</p>
                            {% else %}
                                <p>{{'aki.front.cart.title.total.warning.1'|trans}}</p>
                                <p>{{'aki.front.cart.title.total.warning.2'|trans}}</p>
                            {% endif %}
                        {% endif %}
                        {% for item in Order.tax_free_discount_items %}
                            <dl class="ec-totalBox__spec">
                                <dt>{{ item.product_name }}</dt>
                                <dd>{{ item.total_price|price }}</dd>
                            </dl>
                        {% endfor %}
                        <p id="summary_box__total_amount" class="history-price__total total_price d-flex justify-content-between align-items-baseline">{{'aki.front.cart.total'|trans}} <strong class="color-primary">{{ Order.total|price }}</strong></p>
                        {% if site_key|default(null) and secret_key|default(null) %}
                            <div style="margin-top: 15px; color: #de5d50;">
                                {{'front.shopping.recaptcha.notice'|trans}}
                                <div
                                    data-size="Optional"
                                    class="g-recaptcha"
                                    data-sitekey = {{site_key}}
                                    style="transform:scale(0.77);-webkit-transform:scale(0.77);transform-origin:0 0;-webkit-transform-origin:0 0;"
                                ></div>
                            </div>
                        {% endif %}
                    </div>
                    {% if isSalon %}
                    <button type="submit"
                        class="aki-btn aki-btn-primary btn-block prevention-btn prevention-mask mb20"
                        >確認する</button>
					{% else %}
                        <button type="submit"
                                class="aki-btn aki-btn-primary btn-block prevention-btn prevention-mask mb20"
                        >{{'aki.front.shopping.shipping_button'|trans}}</button>
					{% endif %}
                </div>
            </div>
        </div>
    </form>
    <script src="//cdnjs.cloudflare.com/ajax/libs/numeral.js/2.0.6/numeral.min.js"></script>
{% endblock %}
