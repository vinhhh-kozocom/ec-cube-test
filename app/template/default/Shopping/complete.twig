{% extends 'default_frame.twig' %}
{% set body_class = 'cart_page' %}
{% block main %}
	<div id="">
		<div class="text-center mb20">
			<h2 class="mb20">{{ 'aki.common.complete.title'|trans }}</h2>
			<p>
				{{ 'front.shopping.thanks_for_order'|trans }}<br>
				{{ 'front.shopping.email_sendding_warning1'|trans }}<br>
				{% if not isSalon %}
					{{ 'front.shopping.email_sendding_warning2'|trans }}
				{% endif %}
			</p>
		</div>

		<div id="complete_wrap">
			<div>
				<div class="ec-cartRole__progress">
					<ul class="ec-progress">
						{% set step = 1 %}
						<li class="ec-progress__item">
							<div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
							</div>
							<div class="ec-progress__label">{{ 'front.cart.nav__cart_items'|trans }}
							</div>
						</li>
						{% if is_granted('ROLE_USER') == false %}
							<li class="ec-progress__item">
								<div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
								</div>
								<div class="ec-progress__label">{{ 'front.cart.nav__customer_info'|trans }}
								</div>
							</li>
						{% endif %}
						<li class="ec-progress__item">
							<div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
							</div>
							<div class="ec-progress__label">{{ 'front.cart.nav__order'|trans }}
							</div>
						</li>
						<li class="ec-progress__item">
							<div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
							</div>
							<div class="ec-progress__label">{{ 'front.cart.nav__confirm'|trans }}
							</div>
						</li>
						<li class="ec-progress__item  is-complete">
							<div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
							</div>
							<div class="ec-progress__label">{{ 'front.cart.nav__complete'|trans }}
							</div>
						</li>
					</ul>
				</div>
			</div>
			{% if isSalon %}
				<div id="deliveradd_input_box__message" class="complete_message mb30">
					<p>万一、ご確認メールが届かない場合は、トラブルの可能性もありますので大変お手数ではございますが<br>
					もう一度お問い合わせいただくか、お電話にてお問い合わせくださいませ。<br>
					今後ともご愛顧賜りますようよろしくお願い申し上げます。</p>
				</div>
			{% endif %}
			<div class="row no-padding mb30">
				{% if hasNextCart %}
					<div class="btn_group text-center">
                        {% if isChina %}
                            <a class="aki-btn aki-btn-primary" href="/user_data/china" onclick="gtag('event', 'クリック', {'event_category': 'SPメニュー内','event_label': 'SPメニュー_中文'});">{{ 'front.shopping.continue'|trans }}</a>
                        {% elseif isEnglish %}
                            <a class="aki-btn aki-btn-primary" href="/user_data/english" onclick="gtag('event', 'クリック', {'event_category': 'SPメニュー内','event_label': 'SPメニュー_english'});">{{ 'front.shopping.continue'|trans }}</a>
						{% elseif not isJapan %}
						    <a class="aki-btn aki-btn-primary" href="{{ url('cart_locale') }}">{{ 'common.go_to_top'|trans }}</a>
                        {% else %}
						    <a class="aki-btn aki-btn-primary" href="{{ url('homepage') }}">{{ 'common.go_to_top'|trans }}</a>
                        {% endif %}
					</div>
				{% else %}
					<div class="btn_group text-center">
                    {% if isEnglish %}
						<a class="aki-btn aki-btn-primary" href="/user_data/english">{{ 'common.go_to_top'|trans }}</a>
                    {% elseif isChina %}
                        <a class="aki-btn aki-btn-primary" href="/user_data/china">{{ 'common.go_to_top'|trans }}</a>
					{% else %}
                        <a class="aki-btn aki-btn-primary" href="{{ url('homepage') }}">{{ 'common.go_to_top'|trans }}</a>
                    {% endif %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}
